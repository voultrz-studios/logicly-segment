<!DOCTYPE html>
<html lang="hr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Logički sklopovi — 27.12.2011.</title>
<style>
  :root {
    --bg: #0b0f17;
    --panel: #131a26;
    --border: #233044;
    --accent: #00d2ff;
    --accent-glow: rgba(0, 210, 255, 0.25);
    --text: #e6edf3;
    --muted: #8b949e;
    --green: #3fb950;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 28px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--accent);
    font-size: 1rem;
  }

  .slide-counter {
    color: var(--muted);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  main {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .slide {
    display: none;
    width: 100%;
    max-width: 1200px;
    height: 100%;
    animation: fadeIn 0.28s ease;
  }

  .slide.active {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Naslovni slajd */
  .hero {
    text-align: center;
    gap: 20px;
  }

  .hero h1 {
    font-size: 3.2rem;
    background: linear-gradient(90deg, #ffffff, var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero p {
    font-size: 1.25rem;
    color: var(--muted);
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .digits-preview {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-top: 20px;
  }

  .digit-box {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 28px;
    box-shadow: 0 0 25px var(--accent-glow);
  }

  .digit-box .num {
    font-size: 2.6rem;
    font-weight: 800;
    color: var(--accent);
  }

  .digit-box .bin {
    font-family: monospace;
    font-size: 1rem;
    color: var(--muted);
    margin-top: 4px;
  }

  /* Grid za sklopove */
  .circuit-layout {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 24px;
    height: 100%;
    align-items: center;
  }

  .img-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 12px;
    height: 100%;
    max-height: 74vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    cursor: zoom-in;
    position: relative;
  }

  .img-card img {
    max-width: 100%;
    max-height: 68vh;
    border-radius: 8px;
    object-fit: contain;
  }

  .zoom-hint {
    position: absolute;
    bottom: 10px;
    right: 14px;
    font-size: 0.78rem;
    color: var(--muted);
    background: rgba(11, 15, 23, 0.8);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .info-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .info-card h2 {
    font-size: 2rem;
    color: var(--accent);
  }

  .bit-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bit-list li {
    background: rgba(255, 255, 255, 0.03);
    border-left: 3px solid var(--border);
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .bit-list li.active-bit {
    border-left-color: var(--accent);
    background: rgba(0, 210, 255, 0.08);
  }

  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: monospace;
    font-weight: bold;
    font-size: 0.85rem;
    margin-right: 6px;
  }

  .b1 { background: rgba(0, 210, 255, 0.2); color: var(--accent); }
  .b0 { background: rgba(139, 148, 158, 0.2); color: var(--muted); }

  /* Interaktivni simulator slajd */
  .sim-box {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .sim-controls {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 28px 0;
  }

  .bit-btn {
    background: #1c2536;
    border: 2px solid var(--border);
    color: var(--text);
    padding: 16px 22px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 1.1rem;
    transition: 0.15s;
  }

  .bit-btn.on {
    border-color: var(--accent);
    box-shadow: 0 0 18px var(--accent-glow);
    color: var(--accent);
  }

  .sim-display {
    font-size: 5rem;
    font-weight: 800;
    color: var(--accent);
    background: #090d14;
    border: 2px solid var(--border);
    border-radius: 14px;
    width: 140px;
    height: 140px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Navigacija */
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 28px;
    background: var(--panel);
    border-top: 1px solid var(--border);
  }

  button.nav-btn {
    background: #1c2536;
    color: var(--text);
    border: 1px solid var(--border);
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
  }

  button.nav-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Modal za zumiranje slike */
  #modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 100;
    justify-content: center;
    align-items: center;
    cursor: zoom-out;
  }

  #modal img {
    max-width: 95vw;
    max-height: 95vh;
    border-radius: 8px;
  }
</style>
</head>
<body>

<header>
  <div class="brand">INFORMATIKA // DIGITALNA LOGIKA &amp; LOGIC.LY</div>
  <div class="slide-counter" id="counter">Slajd 1 / 7</div>
</header>

<main>
  <!-- SLAJD 1: Naslov -->
  <section class="slide active">
    <div class="hero">
      <h1>Binarni prikaz rođendana u Logic.lyju</h1>
      <p>Razgranati logički sklopovi s višestupanjskim logičkim vratima (AND, OR, NOT, NAND, NOR, Buffer) i 4-bitnim dekoderima za prikaz znamenki <strong>2, 7, 1, 0</strong>.</p>
      <div class="digits-preview">
        <div class="digit-box"><div class="num">2</div><div class="bin">0 1 0 0</div></div>
        <div class="digit-box"><div class="num">7</div><div class="bin">1 1 1 0</div></div>
        <div class="digit-box"><div class="num">1</div><div class="bin">1 0 0 0</div></div>
        <div class="digit-box"><div class="num">0</div><div class="bin">0 0 0 0</div></div>
      </div>
    </div>
  </section>

  <!-- SLAJD 2: Kako radi 4-Bit Digit -->
  <section class="slide">
    <div class="info-card" style="max-width: 820px; margin: 0 auto;">
      <h2>Kako radi 4-Bit Digit u Logic.lyju?</h2>
      <p style="color: var(--muted); line-height: 1.6;">
        Svaki <strong>4-Bit Digit</strong> prikaz ima 4 ulazna pina s lijeve strane. U Logic.lyju težine pinova idu <strong>odozgo prema dolje</strong> (LSB na vrhu, MSB na dnu):
      </p>
      <ul class="bit-list">
        <li class="active-bit"><span class="badge b1">1. ulaz (vrh)</span> Težina <strong>2⁰ = 1</strong></li>
        <li class="active-bit"><span class="badge b1">2. ulaz</span> Težina <strong>2¹ = 2</strong></li>
        <li class="active-bit"><span class="badge b1">3. ulaz</span> Težina <strong>2² = 4</strong></li>
        <li class="active-bit"><span class="badge b1">4. ulaz (dno)</span> Težina <strong>2³ = 8</strong></li>
      </ul>
      <p style="color: var(--muted); font-size: 0.95rem;">
        Plava žica predstavlja logičku jedinicu (<strong>1</strong> / High), a bijelo-siva žica logičku nulu (<strong>0</strong> / Low). Zbrajanjem aktivnih plavih ulaza dobiva se dekadska znamenka na zaslonu.
      </p>
    </div>
  </section>

  <!-- SLAJD 3: Znamenka 2 -->
  <section class="slide">
    <div class="circuit-layout">
      <div class="img-card" onclick="openModal('znamenka 2 logicly.png')">
        <img src="znamenka 2 logicly.png" alt="Znamenka 2">
        <span class="zoom-hint">Klikni za povećanje</span>
      </div>
      <div class="info-card">
        <h2>Znamenka 2</h2>
        <p style="color: var(--muted);">Aktivira se samo 2. ulaz odozgo (težina 2):</p>
        <ul class="bit-list">
          <li><span class="badge b0">0</span> <strong>Pin 1 (1):</strong> 1 → NOT → OR (s 0) → Buffer = 0</li>
          <li class="active-bit"><span class="badge b1">1</span> <strong>Pin 2 (2):</strong> 1 ∧ 1 → AND → Buffer → OR (s 1) = 1</li>
          <li><span class="badge b0">0</span> <strong>Pin 3 (4):</strong> 0 → Buffer → AND (s 1) → Buffer = 0</li>
          <li><span class="badge b0">0</span> <strong>Pin 4 (8):</strong> 1 ∧ 1 → NAND → Buffer → AND (s 1) = 0</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SLAJD 4: Znamenka 7 -->
  <section class="slide">
    <div class="circuit-layout">
      <div class="img-card" onclick="openModal('znamenka 7 logicly.png')">
        <img src="znamenka 7 logicly.png" alt="Znamenka 7">
        <span class="zoom-hint">Klikni za povećanje</span>
      </div>
      <div class="info-card">
        <h2>Znamenka 7</h2>
        <p style="color: var(--muted);">Aktivna su gornja tri ulaza (1 + 2 + 4 = 7):</p>
        <ul class="bit-list">
          <li class="active-bit"><span class="badge b1">1</span> <strong>Pin 1 (1):</strong> 1 ∧ 0 → AND (0) → NOR (s 0) → Buffer = 1</li>
          <li class="active-bit"><span class="badge b1">1</span> <strong>Pin 2 (2):</strong> 0 ∨ 0 → NOR (1) → OR (s 0) → Buffer = 1</li>
          <li class="active-bit"><span class="badge b1">1</span> <strong>Pin 3 (4):</strong> 1 ∧ 1 → AND (1) → OR (s 0) → Buffer = 1</li>
          <li><span class="badge b0">0</span> <strong>Pin 4 (8):</strong> 1 ∧ 0 → AND (0) → NOR (s 1) → Buffer = 0</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SLAJD 5: Znamenka 1 -->
  <section class="slide">
    <div class="circuit-layout">
      <div class="img-card" onclick="openModal('broj 1 logicly.png')">
        <img src="broj 1 logicly.png" alt="Znamenka 1">
        <span class="zoom-hint">Klikni za povećanje</span>
      </div>
      <div class="info-card">
        <h2>Znamenka 1</h2>
        <p style="color: var(--muted);">Aktivan je isključivo 1. ulaz na vrhu (težina 1):</p>
        <ul class="bit-list">
          <li class="active-bit"><span class="badge b1">1</span> <strong>Pin 1 (1):</strong> 0 ∨ 0 → NOR (1) → Buffer → OR (s 0) = 1</li>
          <li><span class="badge b0">0</span> <strong>Pin 2 (2):</strong> 1 → NOT (0) → AND (s 1) → Buffer = 0</li>
          <li><span class="badge b0">0</span> <strong>Pin 3 (4):</strong> 0 ∧ 1 → AND (0) → OR (s 0) → Buffer = 0</li>
          <li><span class="badge b0">0</span> <strong>Pin 4 (8):</strong> 1 ∧ 1 → NAND (0) → AND (s 1) → Buffer = 0</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SLAJD 6: Znamenka 0 -->
  <section class="slide">
    <div class="circuit-layout">
      <div class="img-card" onclick="openModal('broj 0 logicly.png')">
        <img src="broj 0 logicly.png" alt="Znamenka 0">
        <span class="zoom-hint">Klikni za povećanje</span>
      </div>
      <div class="info-card">
        <h2>Znamenka 0</h2>
        <p style="color: var(--muted);">Sva četiri ulaza su logička nula (0 + 0 + 0 + 0 = 0):</p>
        <ul class="bit-list">
          <li><span class="badge b0">0</span> <strong>Pin 1 (1):</strong> 0 → Buffer → OR (s 0) → Buffer = 0</li>
          <li><span class="badge b0">0</span> <strong>Pin 2 (2):</strong> 1 → NOT (0) → AND (s 1) → Buffer = 0</li>
          <li><span class="badge b0">0</span> <strong>Pin 3 (4):</strong> 1 ∧ 1 → NAND (0) → OR (s 0) → Buffer = 0</li>
          <li><span class="badge b0">0</span> <strong>Pin 4 (8):</strong> 0 ∧ 1 → AND (0) → NOR (s 1) → Buffer = 0</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SLAJD 7: Interaktivna provjera uživo -->
  <section class="slide">
    <div class="sim-box">
      <h2 style="color: var(--accent); margin-bottom: 10px;">Interaktivni 4-Bit Dekoder (Demo uživo)</h2>
      <p style="color: var(--muted);">Klikni na pojedine bitove da vidiš kako 4-Bit Digit računa rezultat:</p>
      <div class="sim-controls">
        <button class="bit-btn" onclick="toggleBit(0)" id="btn0">Pin 1 (1)<br><strong>0</strong></button>
        <button class="bit-btn" onclick="toggleBit(1)" id="btn1">Pin 2 (2)<br><strong>0</strong></button>
        <button class="bit-btn" onclick="toggleBit(2)" id="btn2">Pin 3 (4)<br><strong>0</strong></button>
        <button class="bit-btn" onclick="toggleBit(3)" id="btn3">Pin 4 (8)<br><strong>0</strong></button>
      </div>
      <div class="sim-display" id="hexOut">0</div>
    </div>
  </section>
</main>

<footer>
  <button class="nav-btn" onclick="changeSlide(-1)">← Prethodni</button>
  <span style="color: var(--muted); font-size: 0.85rem;">Koristi strelice ← i → na tipkovnici</span>
  <button class="nav-btn" onclick="changeSlide(1)">Sljedeći →</button>
</footer>

<div id="modal" onclick="this.style.display='none'">
  <img id="modalImg" src="" alt="Uvećani sklop">
</div>

<script>
  let current = 0;
  const slides = document.querySelectorAll('.slide');
  const counter = document.getElementById('counter');

  function showSlide(index) {
    slides[current].classList.remove('active');
    current = (index + slides.length) % slides.length;
    slides[current].classList.add('active');
    counter.textContent = `Slajd ${current + 1} / ${slides.length}`;
  }

  function changeSlide(dir) {
    showSlide(current + dir);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === ' ') changeSlide(1);
    if (e.key === 'ArrowLeft') changeSlide(-1);
    if (e.key === 'Escape') document.getElementById('modal').style.display = 'none';
  });

  function openModal(src) {
    document.getElementById('modalImg').src = src;
    document.getElementById('modal').style.display = 'flex';
  }

  // Simulator logika
  const bits = [0, 0, 0, 0];
  const weights = [1, 2, 4, 8];

  function toggleBit(i) {
    bits[i] = bits[i] ? 0 : 1;
    const btn = document.getElementById('btn' + i);
    btn.classList.toggle('on', bits[i] === 1);
    btn.querySelector('strong').textContent = bits[i];
    const total = bits.reduce((acc, b, idx) => acc + b * weights[idx], 0);
    document.getElementById('hexOut').textContent = total.toString(16).toUpperCase();
  }
</script>

</body>
</html>
